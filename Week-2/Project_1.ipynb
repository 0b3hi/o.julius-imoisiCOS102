   "id": "95b78a19-316a-47b6-877f-b891dfec9849",
   "metadata": {},
   "source": [
    "INPUT price\n",
    "INPUT quantity\n",
    "\n",
    "COMPUTE total = price * quantity\n",
    "OUTPUT = \"Total Amount: \", total\n",
    "\n",
    "INPUT payment_amount\n",
    "\n",
    "IF payment_amount = total THEN\n",
    "OUTPUT \"Payment Successful\"\n",
    "OUTPUT \"Receipt will be sent shortly\"\n",
    "\n",
    "ELSE \n",
    "    OUTPUT \"Failed\"\n",
    "    OUTPUT \"Try again\"\n",
    "END IF\n",
    "\n",
    "END"
   ]
  },
